        )

        print(
            f"  Price: {price_on_report_date}"
        )


    except Exception as e:

        print(
            f"  ERROR processing {symbol}: {e}"
        )

        results.append({

            "Ticker": symbol,
            "Quarter": np.nan,

            "Revenue": np.nan,
