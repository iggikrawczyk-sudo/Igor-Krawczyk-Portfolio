# ============================================================
# HELPER FUNCTIONS
# ============================================================

def get_statement_value(statement, possible_names, column):
    """
    Safely retrieve a value from a Yahoo Finance financial
    statement.

    possible_names = possible names Yahoo may use for the row.
    """

    if statement is None or statement.empty:
        return np.nan

    if column not in statement.columns:
        return np.nan

    for name in possible_names:

        if name in statement.index:

            value = statement.loc[name, column]

            if pd.isna(value):
                return np.nan

            return value

    return np.nan


def get_latest_quarter(ticker):

    """
    Get the most recent quarter that exists in the income
    statement, balance sheet and cash flow statement.
    """

    try:
        income = ticker.quarterly_income_stmt
    except Exception:
        income = pd.DataFrame()

    try:
        balance = ticker.quarterly_balance_sheet
    except Exception:
        balance = pd.DataFrame()

    try:
        cashflow = ticker.quarterly_cashflow
    except Exception:
        cashflow = pd.DataFrame()

    if income is None or income.empty:
        return None, None, None, None

    # Get dates from income statement
    income_dates = set(income.columns)

    # Prefer a quarter that also exists in the other statements
    possible_dates = list(income.columns)

    for quarter in possible_dates:

        if quarter in income_dates:

            return (
                income,
                balance,
                cashflow,
                quarter
            )

    return None, None, None, None


# ============================================================
# MAIN DOWNLOAD
# ============================================================

results = []


for i, symbol in enumerate(tickers, start=1):

    print("=" * 70)
    print(f"[{i}/{len(tickers)}] Downloading {symbol}")

    try:

        ticker = yf.Ticker(symbol)

        # ----------------------------------------------------
        # GET QUARTERLY STATEMENTS
        # ----------------------------------------------------

        income, balance, cashflow, quarter = get_latest_quarter(
            ticker
        )

        if income is None:

            print("  No quarterly financial data found.")

            results.append({

                "Ticker": symbol,
                "Quarter": np.nan,

                "Revenue": np.nan,
                "Gross Profit": np.nan,
                "Operating Income": np.nan,
                "Basic Average Shares": np.nan,
                "EBIT": np.nan,

                "Operating Cashflow": np.nan,

                "Total Debt": np.nan,

                "Current Assets": np.nan,
                "Current Liabilities": np.nan,

                "Total Non Current Liabilities": np.nan,

                "PE": np.nan,
                "PEG": np.nan,

                "Price on Report Date": np.nan

            })

            continue


        print(f"  Quarter: {quarter}")


        # ====================================================
        # INCOME STATEMENT
        # ====================================================

        revenue = get_statement_value(
            income,
            [
                "Total Revenue",
                "Operating Revenue"
            ],
            quarter
        )


        gross_profit = get_statement_value(
            income,
            [
                "Gross Profit"
            ],
            quarter
        )


        operating_income = get_statement_value(
            income,
            [
                "Operating Income",
                "Operating Income Loss"
            ],
            quarter
        )


        basic_average_shares = get_statement_value(
            income,
            [
                "Basic Average Shares",
                "Basic Average Shares Outstanding"
            ],
            quarter
        )


        ebit = get_statement_value(
            income,
            [
                "EBIT",
                "Normalized EBIT"
            ],
            quarter
        )


        # ====================================================
        # CASH FLOW STATEMENT
        # ====================================================

        operating_cashflow = get_statement_value(
            cashflow,
            [
                "Operating Cash Flow",
                "Total Cash From Operating Activities",
                "Cash Flow From Continuing Operating Activities"
            ],
            quarter
        )


        # ====================================================
        # BALANCE SHEET
        # ====================================================

        total_debt = get_statement_value(
            balance,
            [
                "Total Debt"
            ],
            quarter
        )


        current_assets = get_statement_value(
            balance,
            [
                "Current Assets"
            ],
            quarter
        )


        current_liabilities = get_statement_value(
            balance,
            [
                "Current Liabilities"
            ],
            quarter
        )


        total_non_current_liabilities = get_statement_value(
            balance,
            [
                "Total Non Current Liabilities",
                "Total Non-Current Liabilities"
            ],
            quarter
        )


        # ====================================================
        # MARKET DATA
        # ====================================================

        pe = np.nan
        peg = np.nan

        try:

            info = ticker.info

            pe = info.get(
                "trailingPE",
                np.nan
            )

            peg = info.get(
                "pegRatio",
                np.nan
            )

        except Exception as e:

            print(
                f"  Could not retrieve PE/PEG: {e}"
            )


        # ====================================================
        # PRICE ON REPORT DATE
        # ====================================================

        price_on_report_date = np.nan

        try:

            hist = ticker.history(
                period="2y",
                auto_adjust=False
            )

            if not hist.empty:

                hist.index = pd.to_datetime(
                    hist.index
                )

                # Convert quarter to timestamp
                quarter_timestamp = pd.Timestamp(
                    quarter
                )

                # Remove timezone if present
                if hist.index.tz is not None:

                    hist.index = hist.index.tz_localize(
                        None
                    )

                # Find first trading day on or after
                # the report quarter date
                valid_prices = hist[
                    hist.index >= quarter_timestamp
                ]

                if not valid_prices.empty:

                    price_on_report_date = valid_prices[
                        "Close"
                    ].iloc[0]

                else:

                    # If no future date exists,
                    # use closest available price
                    price_on_report_date = hist[
                        "Close"
                    ].iloc[-1]

        except Exception as e:

            print(
                f"  Could not retrieve price: {e}"
            )


        # ====================================================
        # STORE RESULT
        # ====================================================

        results.append({

            "Ticker": symbol,

            "Quarter": quarter,

